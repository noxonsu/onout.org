# Envato Author Credentials
ENVATO_USERNAME=your_envato_username
ENVATO_PASSWORD=your_envato_password

# Optional: 2FA TOTP Secret (if enabled)
# Get this from your 2FA setup QR code
ENVATO_2FA_SECRET=

# Browser Settings
HEADLESS=false
SLOW_MO=100

# Debugging
DEBUG=false
SAVE_SCREENSHOTS=true
SCREENSHOT_DIR=./screenshots

# Timeouts (milliseconds)
PAGE_TIMEOUT=60000
UPLOAD_TIMEOUT=300000

# Session Management
SESSION_FILE=.envato-session
SESSION_VALIDITY_HOURS=24

# Upload Settings
AUTO_SUBMIT=false
DRY_RUN=false

# Paths
UPDATES_DIR=/home/farmFactory/web/farm.wpmix.net/public_html/updates
REPOS_DIR=/root

# Logging
LOG_DIR=./logs
LOG_LEVEL=info
